# =====================================================================
#  SRM - configurazione. Copia in .env (lo fa già ./install.sh)
# =====================================================================

# ---- Porta web (l'UNICA pubblicata sull'host) ----
WEB_PORT=8088                      # cambia se occupata (./install.sh la sceglie libera)
WEB_BIND=0.0.0.0                   # 127.0.0.1 = raggiungibile solo dalla VM (dietro reverse proxy)

# ---- Database (container interno, non esposto) ----
POSTGRES_PASSWORD=change-me        # ./install.sh ne genera una casuale

# ---- Microsoft Entra ID / Graph (vedi docs/m365-setup.md) ----
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
ADMIN_EMAILS=tu@azienda.it         # diventano ADMIN al primo login
DEFAULT_ROLE=SALES                 # ruolo dei nuovi utenti (SALES|BACKOFFICE)
GRAPH_MODE=dry-run                 # "graph" per inviare/leggere davvero; dry-run = solo log

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODE=anthropic                 # "disabled" per spegnere il parsing AI

# ---- SOLO prova/demo: nessun login, tutti admin. MAI esposto in rete ----
AUTH_DISABLED=false
