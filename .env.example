# =====================================================================
#  SRM - configurazione. Copia in .env (lo fa già ./install.sh)
# =====================================================================

# ---- Porta web (l'UNICA pubblicata sull'host; HTTP, oppure HTTPS se in ./certs ci sono tls.crt e tls.key) ----
WEB_PORT=8088                      # cambia se occupata (./install.sh la sceglie libera)
WEB_HOST=                          # nome DNS interno (solo informativo, lo imposta --host)
WEB_BIND=0.0.0.0                   # meglio l'IP interno della VM (es. 10.0.0.5); 127.0.0.1 = raggiungibile solo dalla VM (dietro reverse proxy)

# ---- Database (container interno, non esposto) ----
POSTGRES_PASSWORD=change-me        # ./install.sh ne genera una casuale

# ---- Accesso all'applicazione ----
AUTH_MODE=local                    # local = utente/password gestiti in SRM (pagina "Utenti e ruoli") | entra = Microsoft
SECRET_KEY=                        # firma delle sessioni: ./install.sh la genera (se vuota ne viene creata una nel DB)
TOKEN_TTL_MINUTES=480              # durata della sessione (8 ore)
# Admin creato al PRIMO avvio (solo se non esiste già un admin): utente "admin". Il cambio password è obbligatorio.
DEFAULT_ADMIN_PASSWORD=ChangeMe!2026

# ---- Microsoft 365: invio/lettura mail via Graph (vedi docs/m365-setup.md) ----
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
GRAPH_MODE=dry-run                 # "graph" per inviare/leggere davvero; dry-run = solo log
# Solo con AUTH_MODE=entra:
ADMIN_EMAILS=                      # diventano ADMIN al primo login Microsoft
DEFAULT_ROLE=SALES                 # ruolo dei nuovi utenti Microsoft

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODE=anthropic                 # "disabled" per spegnere il parsing AI

# ---- SOLO sviluppo/test automatici: disattiva il login. MAI in produzione ----
AUTH_DISABLED=false
