# ---- Database ----
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://srm:change-me@db:5432/srm

# ---- Microsoft Entra ID / Graph (vedi docs/m365-setup.md) ----
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
ADMIN_EMAILS=tu@azienda.it        # diventano ADMIN al primo login
DEFAULT_ROLE=SALES                 # ruolo dei nuovi utenti (SALES|BACKOFFICE): privilegio minimo
GRAPH_MODE=dry-run          # "graph" per inviare/leggere davvero; dry-run = solo log

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODE=anthropic          # "disabled" per spegnere il parsing AI

# ---- Solo sviluppo locale ----
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:5173
